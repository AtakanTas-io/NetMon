# Veri ve ağ kapsamı
NETMON_DATA_DIR=
NETMON_SUBNET_OVERRIDE=
NETMON_PING_TARGET=8.8.8.8
NETMON_DNS_DOMAIN=google.com
NETMON_PING_COUNT=4

# Zamanlama ve saklama (saniye/saat)
NETMON_TRAFFIC_SAMPLE_INTERVAL=1
NETMON_DIAGNOSTICS_INTERVAL=15
NETMON_SCAN_INTERVAL=300
NETMON_RETENTION_HOURS=48
NETMON_SESSION_TTL_SECONDS=43200

# Trafik anomalisi
NETMON_ANOMALY_WINDOW_SECONDS=3600
NETMON_ANOMALY_MIN_SAMPLES=30
NETMON_ANOMALY_MIN_BASELINE_BPS=1000000
NETMON_ANOMALY_RATIO=3.0
NETMON_ANOMALY_COOLDOWN_SECONDS=300

# Giriş ve uzak envanter korumaları
NETMON_LOGIN_MAX_ATTEMPTS=5
NETMON_LOGIN_LOCKOUT_SECONDS=300
NETMON_WMI_AUTH_COOLDOWN_SECONDS=900

# Dinleme adresleri
NETMON_HOST=127.0.0.1
NETMON_SYSLOG_HOST=0.0.0.0
NETMON_SYSLOG_PORT=5514
